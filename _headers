# Cloudflare Pages _headers 文件
# 缓存策略配置

# HTML 页面 - 不缓存，确保用户始终获取最新版本
/*
  Cache-Control: public, max-age=0, must-revalidate

# 静态资源 - 文件名没带哈希，必须每次校验（内容没变走 304，不耗流量）
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate

# Service Worker 必须每次都校验，否则老 SW 会一直拿旧缓存
/sw.js
  Cache-Control: no-cache, must-revalidate

# 图片资源 - 30天缓存
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.jpeg
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.ico
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000

# 字体文件 - 1年缓存
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# JSON 数据文件 - 1分钟缓存（模组列表，改完一分钟内生效）
/data/*
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=60

# 公告 / 赞助配置 - 1分钟，改完很快就能看到
/data/announce.json
  Cache-Control: public, max-age=60, s-maxage=60
/data/sponsor.json
  Cache-Control: public, max-age=60, s-maxage=60

# API 端点 - 60秒缓存（评分/统计等，函数自身会覆盖更细的缓存策略）
/api/*
  Cache-Control: public, max-age=60, s-maxage=60

# 安全头
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
